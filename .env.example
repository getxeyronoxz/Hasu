# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Event-driven cognition (all processing is local unless a goal explicitly
# invokes the configured model router).
HASU_ENABLE_COGNITION=true
HASU_ENABLE_INITIATIVE=true
HASU_ENABLE_PROACTIVE_SPEECH=true
HASU_ENABLE_SKILL_LEARNING=true
HASU_ENABLE_REFLECTION=true
HASU_ENABLE_DESKTOP_AWARENESS=true
HASU_ENABLE_SCREEN_AWARENESS=false
PAUSE_AUTONOMY=false
HASU_COGNITION_DEBUG=false

# Model capability routes. Comma-separate one fallback at most.
HASU_FAST_MODEL=gemini-3.5-flash
HASU_REASONING_MODEL=gemini-3.5-flash
HASU_CODE_MODEL=gemini-3.5-flash
HASU_VISION_MODEL=gemini-3.1-flash-live-preview
HASU_EMBEDDING_MODEL=gemini-embedding-001
HASU_SPEECH_MODEL=gemini-3.1-flash-live-preview

# Explicit local capability permissions.
HASU_PERMISSION_MICROPHONE=true
HASU_PERMISSION_SCREEN_AWARENESS=true
HASU_PERMISSION_FILESYSTEM_READ=true
HASU_PERMISSION_FILESYSTEM_WRITE=true
HASU_PERMISSION_DESKTOP_CONTROL=true
HASU_PERMISSION_BROWSER=true
HASU_PERMISSION_NETWORK=true
HASU_PERMISSION_AUTOMATION=true
HASU_PERMISSION_CODE_EXECUTION=true
HASU_PERMISSION_SYSTEM_CONTROL=true

# Runaway/cost limits.
HASU_MAX_PLAN_DEPTH=8
HASU_MAX_RETRIES=2
HASU_MAX_TOOL_CALLS=24
HASU_TASK_TIMEOUT_MS=300000
HASU_REPETITION_COOLDOWN_MS=180000

# Public API capability catalogue (backend-only; providers are not all exposed to the model)
HASU_API_CATALOGUE_SYNC=true
HASU_PUBLIC_APIS_URL=https://raw.githubusercontent.com/public-apis/public-apis/master/README.md
HASU_API_CATALOGUE_MAX_AGE_MS=86400000
HASU_API_HEALTH_TIMEOUT_MS=8000
